# Truth Checker — Gemini configuration
# Get your API key from Google AI Studio:
# https://aistudio.google.com/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used for fact-checking.
# Gemini 2.5 Flash supports Google Search grounding and URL Context.
TRUTHCHECKER_MODEL=gemini-2.5-flash

# Maximum generated web searches for the UI/metadata.
TRUTHCHECKER_MAX_SEARCHES=6

# Cache short TTL to avoid serving outdated news
TRUTHCHECKER_CACHE_TTL=900

# Authentication / user accounts
# Generate a long random value for production (do not share it).
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL=604800
TRUTHCHECKER_DAILY_LIMIT=20

# Optional: absolute path to SQLite database
# TRUTHCHECKER_DB_PATH=./truthchecker.db
