# Truth Checker — Gemini configuration
# Get your API key from Google AI Studio:
# https://aistudio.google.com/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used for fact-checking.
# Gemini 3.5 Flash-Lite is the current stable low-cost model for
# high-volume analysis, structured JSON and grounded search workflows.
TRUTHCHECKER_MODEL=gemini-3.5-flash-lite

# Maximum generated web searches for the UI/metadata.
TRUTHCHECKER_MAX_SEARCHES=6

# Cache short TTL to avoid serving outdated news
TRUTHCHECKER_CACHE_TTL=900

# Authentication / multi-user access
# Generate a long random value for production (do not share it).
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL=604800

# Application-level quota is disabled by default so it cannot mask provider errors as HTTP 429.
TRUTHCHECKER_ENFORCE_DAILY_LIMIT=0
TRUTHCHECKER_DAILY_LIMIT=1000

# Optional: absolute path to SQLite database
# TRUTHCHECKER_DB_PATH=./truthchecker.db
