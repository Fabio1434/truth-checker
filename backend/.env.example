# Copy this file to ".env" (same folder) and fill in the key(s) you have.
#
# Truth Checker can use up to 3 LLM providers with automatic fallback:
# Groq -> Gemini -> OpenAI. Configure ANY SUBSET (even just one). Requests
# try Groq first; if it errors or is rate-limited, Gemini is tried next,
# then OpenAI. At least one key is required.

# Groq Console: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override the default model used for each provider.
# TRUTHCHECKER_GROQ_MODEL=groq/compound
# TRUTHCHECKER_GEMINI_MODEL=gemini-2.5-flash
# TRUTHCHECKER_OPENAI_MODEL=gpt-4.1

# Maximum generated web searches for the model's research plan.
TRUTHCHECKER_MAX_SEARCHES=6

# Cache court pour éviter de servir des actualités trop anciennes
TRUTHCHECKER_CACHE_TTL=900

# Authentication / user accounts
# Generate a long random value for production (do not share it).
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL=604800
TRUTHCHECKER_DAILY_LIMIT=20

# Optional: absolute path to SQLite database
# TRUTHCHECKER_DB_PATH=./truthchecker.db
